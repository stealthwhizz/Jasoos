# Copy to .env.local. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything below is server-only.

# true = every external call returns fixture data
USE_FIXTURES=true

# 0G Private Computer (OpenAI-compatible Router). Keys from pc.0g.ai > Dashboard > API Keys.
ZG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
# Inference key (sk-...)
ZG_COMPUTE_API_KEY=
# IDs from GET https://router-api.0g.ai/v1/models (no auth). Defaults picked for JSON + vision support.
ZG_IMAGE_MODEL=bytedance/seedream-5.0-flash
ZG_VISION_MODEL=qwen3-vl-plus
ZG_CHAT_MODEL=0gm-1.0-35b-a3b
# Optional management key (mk-..., scope account:read) to show the credit balance
ZG_MANAGEMENT_KEY=

# Arkiv testnet "rabdi"
ARKIV_RPC_URL=
ARKIV_CHAIN_ID=7794095
ARKIV_SIGNER_KEY=
ARKIV_PROJECT_ID=ethjasoos

# World ID (developer portal)
WORLD_APP_ID=
WORLD_ACTION_ID=

# Cost controls
CREATION_LIMIT_PER_DAY=3
CREDIT_CAP_PER_MAKER=50
CREATION_PAUSED=false
