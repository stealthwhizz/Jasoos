# Copy to .env.local. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything below is server-only.

# 0G Private Computer (OpenAI-compatible Router). Keys from pc.0g.ai > Dashboard > API Keys.
ZG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
# Inference key (sk-...)
ZG_COMPUTE_API_KEY=
# IDs from GET https://router-api.0g.ai/v1/models (no auth). Defaults picked for JSON + vision support.
ZG_IMAGE_MODEL=bytedance/seedream-5.0-flash
ZG_VISION_MODEL=qwen3-vl-plus
ZG_CHAT_MODEL=0gm-1.0-35b-a3b
# Voice on 0G: characters speak (MiniMax speech) and players talk back (Whisper).
ZG_TTS_MODEL=minimax-speech-2.8-turbo
ZG_STT_MODEL=whisper-large-v3
# Set on to restore reasoning on 0gm text calls (slower).
ZG_CHAT_THINKING=off

# Arkiv testnet "rabdi"
ARKIV_RPC_URL=
ARKIV_CHAIN_ID=7794095
# Server-only. A funded rabdi key (https://hub.arkiv.network/faucet). Empty = in-memory stand-in.
ARKIV_SIGNER_KEY=
# Free key from https://hub.arkiv.network/access-keys. Empty = public, heavily rate-limited RPC.
ARKIV_ACCESS_KEY=
ARKIV_PROJECT_ID=ethjasoos

# World ID (developer portal)
WORLD_APP_ID=
WORLD_ACTION_ID=create-world
WORLD_RP_ID=
# Server-only. Signs the rp_context the widget needs; never expose it to the browser.
WORLD_RP_SIGNING_KEY=
# staging = web simulator (https://simulator.worldcoin.org)
# sandbox = World ID Sandbox test app on a phone (turn off its attestation enforcement in the
#           Developer Portal > World ID Sandbox, or World answers 403 integrity_verification_failed)
# production = real World App
WORLD_ENVIRONMENT=staging
# Signs the session cookie. Required in production; dev uses a fixed secret when empty.
SESSION_SECRET=

# Worlds each player may create. 0 = creation off (gallery only).
FREE_GAME_LIMIT=3
# Comma-separated player ids that skip FREE_GAME_LIMIT.
UNLIMITED_PLAYERS=
# Where generated images are saved (served by /api/assets).
ASSET_DIR=.data/assets
# Play-session timer in seconds.
NEXT_PUBLIC_SESSION_TIME_LIMIT_SEC=300

# Sarvam Bulbul v3 NPC voices (https://sarvam.ai). Empty = silent NPCs.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN

# PostHog analytics. Empty token = no events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
