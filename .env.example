# Copy to .env.local. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything below is server-only.

# true = every external call returns fixture data
USE_FIXTURES=true

# 0G Private Computer (OpenAI-compatible)
ZG_COMPUTE_BASE_URL=
ZG_COMPUTE_API_KEY=
ZG_IMAGE_MODEL=
ZG_VISION_MODEL=
ZG_CHAT_MODEL=

# Arkiv testnet "rabdi"
ARKIV_RPC_URL=
ARKIV_CHAIN_ID=7794095
ARKIV_SIGNER_KEY=
ARKIV_PROJECT_ID=ethjasoos

# World ID (developer portal)
WORLD_APP_ID=
WORLD_ACTION_ID=create-world
WORLD_RP_ID=
# Server-only. Signs the rp_context the widget needs; never expose it to the browser.
WORLD_RP_SIGNING_KEY=
# staging = simulator proofs (https://simulator.worldcoin.org); production = real World App
WORLD_ENVIRONMENT=staging

# Cost controls
CREATION_LIMIT_PER_DAY=3
CREDIT_CAP_PER_MAKER=50
CREATION_PAUSED=false
